{
  "name": "mako",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude='**/*.property.test.ts' --exclude='**/e2e/**'",
    "test:property": "vitest run --include='**/*.property.test.ts'",
    "test:e2e": "vitest run --include='**/e2e/**'",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "lint": "eslint 'packages/*/src/**/*.ts'"
  },
  "devDependencies": {
    "@mako-agent/cli": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "fast-check": "^3.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
