{
  "name": "@mako-agent/core",
  "version": "0.1.0",
  "description": "Core engine for Mako AI Coding Agent - ReAct loop, LLM adapter, context pipeline, tool registry",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./llm": {
      "import": "./dist/llm/index.js",
      "types": "./dist/llm/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueStoneQ/mako.git",
    "directory": "packages/core"
  },
  "keywords": ["ai", "agent", "coding", "llm", "react-loop", "openai"],
  "author": "BlueStoneQ",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.0",
    "minisearch": "^7.2.0",
    "openai": "^4.50.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "fast-check": "^3.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
